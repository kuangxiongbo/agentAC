# 代理客户端（mission-control-client）本机开发示例
# cp .env.local.example .env.local

# 仅通过「设置 → 服务网关地址」HTTP 同步上游（如 https://agent.1sheng.work），
# 本机无 OpenClaw 网关时不要自动连 WebSocket（避免误连 ws://127.0.0.1:5001/gateway-ws）
NEXT_PUBLIC_GATEWAY_OPTIONAL=true

# 若本机有 OpenClaw 网关，改为 false 并配置：
# NEXT_PUBLIC_GATEWAY_OPTIONAL=false
# NEXT_PUBLIC_GATEWAY_HOST=127.0.0.1
# NEXT_PUBLIC_GATEWAY_PORT=18789
# 或反代：NEXT_PUBLIC_GATEWAY_URL=wss://agent.1sheng.work/gateway-ws

OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
