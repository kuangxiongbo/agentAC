{
  "name": "mission-control-manage",
  "version": "2.1.1",
  "description": "Manage a running E-AgentCenter instance — health checks, diagnostics, upgrades, backups",
  "author": "Builderz Labs",
  "license": "MIT",
  "tools": [
    "exec",
    "http"
  ],
  "parameters": {
    "base_url": {
      "type": "string",
      "default": "http://localhost:3000",
      "description": "E-AgentCenter base URL"
    },
    "api_key": {
      "type": "string",
      "description": "API key for authentication (x-api-key header)"
    }
  },
  "tags": [
    "mission-control",
    "management",
    "health",
    "upgrade",
    "backup"
  ]
}
