{
  "name": "mission-control-installer",
  "version": "2.1.1",
  "description": "Install and configure E-AgentCenter — the OpenClaw agent orchestration dashboard",
  "author": "Builderz Labs",
  "license": "MIT",
  "tools": [
    "exec",
    "fs"
  ],
  "parameters": {
    "deployment_mode": {
      "type": "string",
      "enum": [
        "docker",
        "local"
      ],
      "default": "docker",
      "description": "How to deploy E-AgentCenter"
    },
    "port": {
      "type": "number",
      "default": 3000,
      "description": "Port for the E-AgentCenter dashboard"
    },
    "install_dir": {
      "type": "string",
      "default": "",
      "description": "Installation directory (defaults to ./mission-control)"
    }
  },
  "tags": [
    "mission-control",
    "dashboard",
    "installer",
    "docker"
  ]
}
