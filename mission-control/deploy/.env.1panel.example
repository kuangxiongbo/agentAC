# ═══════════════════════════════════════════════════════════════════════════════
# Mission Control — 1Panel / 生产环境变量示例 → 保存为 1panel.env
# ═══════════════════════════════════════════════════════════════════════════════
# 1Panel：在 Compose 应用「环境变量」中填写，面板会写入 1panel.env（compose 已 env_file 引用）。
# 命令行：cp .env.1panel.example 1panel.env 后编辑。勿提交 1panel.env（含密钥）。
# 完整说明见仓库 .env.example。

# 镜像与容器名见同目录 docker-compose.1panel.yml（勿在此重复配置）
# 宿主机端口见 compose 中 ports（默认 127.0.0.1:3000）

# ─── 数据目录（一般不必改；数据在 Docker 卷 /app/.data）──────────────────────
# MISSION_CONTROL_DATA_DIR=/app/.data
# MISSION_CONTROL_DB_PATH=/app/.data/mission-control.db
# MISSION_CONTROL_TOKENS_PATH=/app/.data/mission-control-tokens.json

# ─── 安全与站点（生产必填）────────────────────────────────────────────────────
# 会话与 OIDC Cookie 签名；务必固定随机串，勿泄露
AUTH_SECRET=
# 头less API：x-api-key；务必固定
API_KEY=

# 若仍使用本地管理员账号登录（非纯 SSO），需设置（或通过 /setup 首次创建）
# AUTH_USER=admin
# AUTH_PASS=

# 对外访问的域名，逗号分隔；须含浏览器地址栏里的 host
MC_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# 反代 HTTPS 时通常为 1 或 true
MC_COOKIE_SECURE=1
# 有 OIDC 时建议 lax（默认）；见根 .env.example 说明
# MC_COOKIE_SAMESITE=lax

# ─── 网关：服务端（容器内 MC → 网关）──────────────────────────────────────────
# 网关在宿主机：host.docker.internal（compose 已配 Linux extra_hosts）
OPENCLAW_GATEWAY_HOST=host.docker.internal
OPENCLAW_GATEWAY_PORT=18789
# OPENCLAW_GATEWAY_TOKEN=

# 网关在「另一容器」：改为服务名，并保证与 MC 在同一 docker network（可自建 stack 把两服务写进同一 compose）
# OPENCLAW_GATEWAY_HOST=openclaw-gateway

# ─── 网关：浏览器侧（用户浏览器 → 网关 WS）────────────────────────────────────
# 网关与控制台同域反代时可留空，由前端自动推断；否则填公网域名或 wss URL
# NEXT_PUBLIC_GATEWAY_HOST=yourdomain.com
NEXT_PUBLIC_GATEWAY_PORT=18789
# NEXT_PUBLIC_GATEWAY_URL=wss://yourdomain.com/gw

# 无网关仅控制台时可打开
# NEXT_PUBLIC_GATEWAY_OPTIONAL=true

# ─── Zitadel / 用户中心（按需）────────────────────────────────────────────────
# 同机多域名：见 deploy/SAME-HOST-NETWORK.md（避免容器用公网 URL 访问同机用户中心「绕圈」）
# ZITADEL_ISSUER=https://sso.example.com
# ZITADEL_CLIENT_ID=
# ZITADEL_CLIENT_SECRET=
# ZITADEL_REDIRECT_URI=https://mc.example.com/api/auth/callback
# ZITADEL_POST_LOGOUT_REDIRECT_URI=https://mc.example.com/login
# 服务端（MC 容器内 fetch）— 同机请用内网，勿写 https://user.example.com
# USER_CENTER_API_URL=http://host.docker.internal:8080
# USER_CENTER_INTERNAL_SECRET=
# 浏览器跳转 — 公网域名
# USER_CENTER_PORTAL_URL=https://user.example.com
# MC_ZITADEL_REQUIRE_USERCENTER=1
# MC_USERCENTER_ONBOARDING_MODE=local

# ─── 边缘 Bridge（代理客户端拉会话记录、下发任务）────────────────────────────
# 容器内 Bridge 监听 5002；公网须由 Nginx 反代 WebSocket，勿直接暴露 5002 防火墙。
# 示例：location /bridge-ws { proxy_pass http://127.0.0.1:5002; … upgrade … }
# MC_BRIDGE_PUBLIC_WS_URL=wss://agent.example.com/bridge-ws
# compose 需增加：127.0.0.1:5002:5002

# ─── 资源限制（与 compose deploy 对应，可选）──────────────────────────────────
# MC_MEMORY_LIMIT=768M
# MC_CPU_LIMIT=1.0
