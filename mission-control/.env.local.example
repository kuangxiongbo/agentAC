# 本机统一登录：复制为 `.env.local`（已在 .gitignore，勿提交）。
#   cp .env.local.example .env.local
#
# 变量名与 `/Users/kuangxb/Desktop/yisheng/1sheng-console` 中 Zitadel OIDC 段一致；
# Mission Control 为直连 IdP（授权码 + PKCE）。与 1sheng-console 一致时：Zitadel 通过后须调用户中心校验租户/角色，再落本地会话。
# 复制本文件为 `.env.local` 后，至少填写 ZITADEL_*、AUTH_SECRET；若接奕升用户中心，建议同时启用下列变量（详见仓库 `.env.example`）。
#
# 与 1sheng-console 根目录 `.env` 对齐的公开地址（勿提交密钥）：
#   ZITADEL_ISSUER=https://sso.1sheng.work
#   USER_CENTER_API_URL=https://user.1sheng.work
#   USER_CENTER_PORTAL_URL=https://user.1sheng.work
#   MC_ZITADEL_REQUIRE_USERCENTER=1
#   USER_CENTER_INTERNAL_SECRET=（与用户中心约定后填写，可选）
# 1sheng 本机回调/登出示例（见该仓库 `.env.local.example`）：
#   http://localhost:3010/api/auth/callback 、 http://localhost:3010/user
#
# Zitadel 应用「重定向 URI」须与本机访问 MC 的协议+主机+端口+路径一致，例如 dev 端口 5000：
#   http://127.0.0.1:5000/api/auth/callback
# （若浏览器用 http://localhost:5000 打开，则回调应写 localhost 款并在 Zitadel 里同样登记）

# Issuer（与 1sheng-console 相同）
# ZITADEL_ISSUER=https://sso.1sheng.work

# 此前为 E-Agent / 指挥仓下发的 OIDC 应用 Client ID（公网可见，可写在本文件）
# ZITADEL_CLIENT_ID=372833575113850886

# 仅在 Zitadel 控制台可见；粘贴到 .env.local，勿提交仓库、勿发到聊天
# ZITADEL_CLIENT_SECRET=

# 须与 Zitadel 应用内「重定向 URI」逐字一致（协议/主机/端口/路径）
# ZITADEL_REDIRECT_URI=http://127.0.0.1:5000/api/auth/callback
# ZITADEL_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5000/login

# 与 Zitadel 自助注册页完全一致的 URL（登录页「注册帐号」链接；示例路径以你方 Zitadel 实际为准）
# ZITADEL_REGISTER_URL=https://sso.1sheng.work/ui/login/register
# 可不写：若已配置 ZITADEL_ISSUER 且未设上一项，服务端会默认使用 {issuer}/ui/login/register

# 若访问 ZITADEL_ISSUER 报证书错误（自签链），仅开发可设（勿提交生产）：
# MC_OIDC_TLS_INSECURE=1
# MC_USERCENTER_TLS_INSECURE=1

# 可选：仅 SSO，打开 /login 即跳转 IdP；应急本地表单：/login?local=1
# MC_UNIFIED_LOGIN=sso_only

# 必填：OIDC 发起登录时签名短期 Cookie（与上方 ZITADEL_* 同属「统一登录」最小集合）
# 未设置时访问 /api/auth/zitadel 会 500（提示无法发起 OIDC 或 AUTH_SECRET 相关说明）
# AUTH_SECRET=请填足够长的随机串

# 用户中心两步认证（与上方「公开地址」清单一致；取消注释并填 INTERNAL_SECRET 后生效）
# USER_CENTER_API_URL=https://user.1sheng.work
# USER_CENTER_PORTAL_URL=https://user.1sheng.work
# MC_ZITADEL_REQUIRE_USERCENTER=1
# USER_CENTER_INTERNAL_SECRET=
