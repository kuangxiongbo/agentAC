# AgentCenter release handoff environment template.
# Copy to `.handoff/agentcenter.release.env` on the release machine and fill secrets locally.
# `.handoff/*.env` is ignored by Git. Do not commit the filled file.

# Project paths
AGENTCENTER_REPO_ROOT="/Users/kuangxb/Desktop/agent指挥仓"
AGENTCENTER_SERVER_ROOT="/Users/kuangxb/Desktop/agent指挥仓/mission-control"
AGENTCENTER_CLIENT_ROOT="/Users/kuangxb/Desktop/agent指挥仓/mission-control-client"
AGENTCENTER_TRAY_ROOT="/Users/kuangxb/Desktop/agent指挥仓/mission-control-tray"

# GitHub
AGENTCENTER_GIT_REMOTE_SSH="git@github.com:kuangxiongbo/agentAC.git"
AGENTCENTER_GIT_REMOTE_HTTPS="https://github.com/kuangxiongbo/agentAC.git"
AGENTCENTER_GIT_BRANCH="main"
GITHUB_USERNAME="kuangxiongbo"
GITHUB_TOKEN=""

# Aliyun ACR
ACR_REGISTRY="crpi-c9b9bml2ajb23n5d.cn-shenzhen.personal.cr.aliyuncs.com"
ACR_NAMESPACE="1sheng"
ACR_REPOSITORY="agentcenter"
ACR_IMAGE="crpi-c9b9bml2ajb23n5d.cn-shenzhen.personal.cr.aliyuncs.com/1sheng/agentcenter"
ACR_USERNAME="kuangxiongbo@163.com"
ACR_PASSWORD=""

# Build/publish defaults
MC_DOCKER_PLATFORM="linux/amd64"
MC_DOCKER_PUSH="1"
MC_IMAGE=""
MC_IMAGE_LATEST="crpi-c9b9bml2ajb23n5d.cn-shenzhen.personal.cr.aliyuncs.com/1sheng/agentcenter:latest"

# Production URLs
AGENTCENTER_PROD_URL="https://agent.1sheng.work"
USER_CENTER_PORTAL_URL="https://user.1sheng.work"
USER_CENTER_API_URL="https://user.1sheng.work"

# License contract
LICENSE_APP_ID="mission-control"
AGENTCENTER_DISPLAY_APP_NAME="agentCenter"

# Optional production OIDC values.
# Fill from the production 1Panel env / Zitadel app settings when needed.
ZITADEL_CLIENT_ID=""
OIDC_APPLICATION_ID=""
ZITADEL_ISSUER=""

# Quick commands:
# source .handoff/agentcenter.release.env
# docker login --username="$ACR_USERNAME" "$ACR_REGISTRY"
# cd "$AGENTCENTER_SERVER_ROOT"
# export MC_IMAGE="$ACR_IMAGE:$(node -p "require('./package.json').version")"
# export MC_IMAGE_LATEST="$ACR_IMAGE:latest"
# export MC_DOCKER_PUSH=1
# export MC_DOCKER_PLATFORM=linux/amd64
# bash scripts/docker-buildx-multiarch.sh
